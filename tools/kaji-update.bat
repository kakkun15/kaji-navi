@echo off
chcp 65001 >nul
setlocal
rem 鍛冶ナビ 自分用(画面読み取りつき)を新しくする。kaji-handover フォルダに置いてダブルクリック。
set "BASE=%~dp0"
set "CODE=%BASE%unzipped_code"
set "URL=https://github.com/kakkun15/kaji-navi/archive/refs/heads/claude/friendly-pascal-189t8s.zip"
set "TMPD=%TEMP%\kaji-update"

if not exist "%CODE%\kaji-open\src\app.html" (
  echo [だめ] %CODE%\kaji-open\src が見つからない。このファイルを kaji-handover フォルダに置いてから開いて。
  pause & exit /b 1
)
if not exist "%CODE%\kaji-self\build.py" (
  echo [だめ] %CODE%\kaji-self\build.py が見つからない。
  pause & exit /b 1
)

echo 1/4 GitHub から新しい版を落としています...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; if (Test-Path '%TMPD%') { Remove-Item -Recurse -Force '%TMPD%' }; New-Item -ItemType Directory '%TMPD%' | Out-Null; Invoke-WebRequest -UseBasicParsing '%URL%' -OutFile '%TMPD%\k.zip'; Expand-Archive '%TMPD%\k.zip' '%TMPD%'"
if errorlevel 1 ( echo [だめ] ダウンロードか展開に失敗した。ネットにつながっているか確かめて。 & pause & exit /b 1 )
set "SRC="
for /d %%D in ("%TMPD%\kaji-navi-*") do set "SRC=%%D"
if not defined SRC ( echo [だめ] 展開したフォルダが見つからない。 & pause & exit /b 1 )

echo 2/4 今の版を控えています(kaji-open\backup)...
if not exist "%CODE%\kaji-open\backup" (
  xcopy /e /i /q /y "%CODE%\kaji-open\src" "%CODE%\kaji-open\backup\src" >nul
  copy /y "%CODE%\kaji-open\train\w_hidane_h128_best.json" "%CODE%\kaji-open\backup\" >nul
)

echo 3/4 新しい計算と重みを入れています...
xcopy /e /i /q /y "%SRC%\src" "%CODE%\kaji-open\src" >nul
copy /y "%SRC%\train\w_hidane_h128_best.json" "%CODE%\kaji-open\train\" >nul
if exist "%CODE%\kaji-navi\src" (
  xcopy /e /i /q /y "%SRC%\src" "%CODE%\kaji-navi\src" >nul
  copy /y "%SRC%\train\w_hidane_h128_best.json" "%CODE%\kaji-navi\train\" >nul
)

echo 4/4 読み取りつきの版を作っています...
set "KCODE=%CODE%"
set "KSRC=%SRC%"
set "KBASE=%BASE:~0,-1%"
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
if errorlevel 1 ( echo [だめ] 作り直しに失敗した。上の赤い文を Claude に貼って。 & pause & exit /b 1 )

echo.
echo できた。%BASE%kaji-navi-self.html を Chrome か Edge で開いて。
echo ひだねを選んで、最初の推奨が「火力上げ ×2」なら新しい版。
pause
