;; kaji-navi: small MLP (D -> H -> H -> 1, tanh) with WASM SIMD. Built into value.js as base64 (MLP_WASM).
;; Build: npm i wabt@1.0.36 ; parseWat(text, {simd:true}).toBinary({})
(module
  (import "e" "mem" (memory 1))
  ;; tanh for 4 values at once (continued fraction 7/6, clamp |x| <= 4.97, error ~1e-6)
  (func $tanh4 (param $p i32) (param $m i32)
    (local $i i32) (local $x v128) (local $x2 v128) (local $num v128) (local $den v128) (local $a i32)
    (local.set $i (i32.const 0))
    (block $done (loop $l
      (br_if $done (i32.ge_u (local.get $i) (local.get $m)))
      (local.set $a (i32.add (local.get $p) (i32.shl (local.get $i) (i32.const 2))))
      (local.set $x (f32x4.min (f32x4.max (v128.load (local.get $a)) (f32x4.splat (f32.const -4.97))) (f32x4.splat (f32.const 4.97))))
      (local.set $x2 (f32x4.mul (local.get $x) (local.get $x)))
      (local.set $num (f32x4.mul (local.get $x)
        (f32x4.add (f32x4.splat (f32.const 135135))
          (f32x4.mul (local.get $x2) (f32x4.add (f32x4.splat (f32.const 17325))
            (f32x4.mul (local.get $x2) (f32x4.add (f32x4.splat (f32.const 378)) (local.get $x2))))))))
      (local.set $den (f32x4.add (f32x4.splat (f32.const 135135))
          (f32x4.mul (local.get $x2) (f32x4.add (f32x4.splat (f32.const 62370))
            (f32x4.mul (local.get $x2) (f32x4.add (f32x4.splat (f32.const 3150))
              (f32x4.mul (local.get $x2) (f32x4.splat (f32.const 28)))))))))
      (v128.store (local.get $a) (f32x4.min (f32x4.max (f32x4.div (local.get $num) (local.get $den)) (f32x4.splat (f32.const -1))) (f32x4.splat (f32.const 1))))
      (local.set $i (i32.add (local.get $i) (i32.const 4)))
      (br $l))))
  ;; out[j] = b[j] + sum W[j*n+q]*in[q] ; n multiple of 4 ; 2 rows at a time to reuse the input loads
  (func $layer (param $in i32) (param $n i32) (param $m i32) (param $W i32) (param $b i32) (param $out i32) (param $act i32)
    (local $j i32) (local $q i32) (local $a0 v128) (local $a1 v128) (local $r0 i32) (local $r1 i32) (local $xv v128) (local $off i32) (local $rb i32)
    (local.set $rb (i32.shl (local.get $n) (i32.const 2)))
    (local.set $j (i32.const 0))
    (block $done (loop $lj
      (br_if $done (i32.ge_u (local.get $j) (local.get $m)))
      (local.set $r0 (i32.add (local.get $W) (i32.mul (local.get $j) (local.get $rb))))
      (local.set $a0 (f32x4.splat (f32.const 0)))
      (if (i32.lt_u (i32.add (local.get $j) (i32.const 1)) (local.get $m))
        (then
          (local.set $r1 (i32.add (local.get $r0) (local.get $rb)))
          (local.set $a1 (f32x4.splat (f32.const 0)))
          (local.set $q (i32.const 0))
          (block $dq (loop $lq
            (br_if $dq (i32.ge_u (local.get $q) (local.get $rb)))
            (local.set $xv (v128.load (i32.add (local.get $in) (local.get $q))))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load (i32.add (local.get $r0) (local.get $q))) (local.get $xv))))
            (local.set $a1 (f32x4.add (local.get $a1) (f32x4.mul (v128.load (i32.add (local.get $r1) (local.get $q))) (local.get $xv))))
            (local.set $q (i32.add (local.get $q) (i32.const 16)))
            (br $lq)))
          (f32.store (i32.add (local.get $out) (i32.shl (i32.add (local.get $j) (i32.const 1)) (i32.const 2)))
            (f32.add (f32.load (i32.add (local.get $b) (i32.shl (i32.add (local.get $j) (i32.const 1)) (i32.const 2))))
              (f32.add (f32.add (f32x4.extract_lane 0 (local.get $a1)) (f32x4.extract_lane 1 (local.get $a1)))
                       (f32.add (f32x4.extract_lane 2 (local.get $a1)) (f32x4.extract_lane 3 (local.get $a1)))))))
        (else
          (local.set $q (i32.const 0))
          (block $dq2 (loop $lq2
            (br_if $dq2 (i32.ge_u (local.get $q) (local.get $rb)))
            (local.set $a0 (f32x4.add (local.get $a0) (f32x4.mul (v128.load (i32.add (local.get $r0) (local.get $q))) (v128.load (i32.add (local.get $in) (local.get $q))))))
            (local.set $q (i32.add (local.get $q) (i32.const 16)))
            (br $lq2)))))
      (f32.store (i32.add (local.get $out) (i32.shl (local.get $j) (i32.const 2)))
        (f32.add (f32.load (i32.add (local.get $b) (i32.shl (local.get $j) (i32.const 2))))
          (f32.add (f32.add (f32x4.extract_lane 0 (local.get $a0)) (f32x4.extract_lane 1 (local.get $a0)))
                   (f32.add (f32x4.extract_lane 2 (local.get $a0)) (f32x4.extract_lane 3 (local.get $a0))))))
      (local.set $j (i32.add (local.get $j) (i32.const 2)))
      (br $lj)))
    (if (local.get $act) (then (call $tanh4 (local.get $out) (local.get $m)))))
  ;; (tried: 4 inputs at once like GEMM -> no gain here, the weights stay in cache; removed)
  (func (export "mlp") (param $x i32) (param $D4 i32) (param $H i32) (param $W1 i32) (param $b1 i32) (param $W2 i32) (param $b2 i32) (param $W3 i32) (param $b3 i32) (param $h1 i32) (param $h2 i32) (result f32)
    (call $layer (local.get $x) (local.get $D4) (local.get $H) (local.get $W1) (local.get $b1) (local.get $h1) (i32.const 1))
    (call $layer (local.get $h1) (local.get $H) (local.get $H) (local.get $W2) (local.get $b2) (local.get $h2) (i32.const 1))
    (call $layer (local.get $h2) (local.get $H) (i32.const 1) (local.get $W3) (local.get $b3) (local.get $h1) (i32.const 0))
    (f32.load (local.get $h1)))
)
